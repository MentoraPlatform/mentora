{
  "name": "@mentora/runtime-relay",
  "version": "0.0.0",
  "private": true,
  "description": "The generic Outbox relay engine (F5.1 species Relay; A-4: publication reads retention) - envelope transport only, no domain, no business logic; abstract publisher port; bounded retries with backoff (M-8) into witnessed quarantine.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract-suite": {
      "types": "./dist/testing/relay-contract-suite.d.ts",
      "import": "./dist/testing/relay-contract-suite.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@mentora/eslint-config": "workspace:*",
    "@mentora/eslint-plugin-mentora": "workspace:*",
    "@mentora/testing-clock": "workspace:*",
    "@mentora/testing-config": "workspace:*",
    "@mentora/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@mentora/kernel": "workspace:*",
    "@mentora/runtime-bootstrap": "workspace:*",
    "@mentora/runtime-health": "workspace:*",
    "@mentora/runtime-metrics": "workspace:*",
    "@mentora/runtime-tracing": "workspace:*",
    "@mentora/shared": "workspace:*"
  }
}
