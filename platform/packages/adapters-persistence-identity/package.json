{
  "name": "@mentora/adapters-persistence-identity",
  "version": "0.0.0",
  "private": true,
  "description": "The PostgreSQL/Prisma persistence adapter of the Identity & Access registries - the first real implementation of CredentialRepository and SessionRepository (Stories #64/#68; RC-1 canonical model; RFC-001 RetentionContext). The ports stay the domain's; everything here is mechanism (S-1).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "prisma:generate": "prisma generate",
    "clean": "rimraf dist .turbo src/generated/prisma"
  },
  "devDependencies": {
    "@mentora/eslint-config": "workspace:*",
    "@mentora/eslint-plugin-mentora": "workspace:*",
    "@mentora/testing-config": "workspace:*",
    "@mentora/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prisma": "6.19.3",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@mentora/runtime-config": "workspace:*"
  },
  "dependencies": {
    "@mentora/application-identity": "workspace:*",
    "@mentora/application-kernel": "workspace:*",
    "@mentora/contracts": "workspace:*",
    "@mentora/contracts-identity": "workspace:*",
    "@mentora/domain-identity": "workspace:*",
    "@mentora/kernel": "workspace:*",
    "@mentora/runtime-bootstrap": "workspace:*",
    "@mentora/runtime-relay": "workspace:*",
    "@mentora/runtime-security": "workspace:*",
    "@mentora/runtime-serialization": "workspace:*",
    "@prisma/client": "6.19.3"
  }
}
