{
  "name": "@mentora/adapters-persistence-agreement",
  "version": "0.0.0",
  "private": true,
  "description": "The PostgreSQL/Prisma persistence adapter of the Agreement registry - the first real implementation of AgreementRepository (Blueprint 2A-2; RC-1 canonical model). The port stays the domain's; everything here is mechanism (S-1).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract-suite": {
      "types": "./dist/testing/agreement-persistence-contract-suite.d.ts",
      "import": "./dist/testing/agreement-persistence-contract-suite.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "prisma:generate": "prisma generate",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@mentora/eslint-config": "workspace:*",
    "@mentora/eslint-plugin-mentora": "workspace:*",
    "@mentora/testing-config": "workspace:*",
    "@mentora/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prisma": "6.19.3",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@mentora/runtime-config": "workspace:*"
  },
  "dependencies": {
    "@mentora/application-agreement": "workspace:*",
    "@mentora/application-kernel": "workspace:*",
    "@mentora/contracts": "workspace:*",
    "@mentora/contracts-agreement": "workspace:*",
    "@mentora/domain-agreement": "workspace:*",
    "@mentora/kernel": "workspace:*",
    "@mentora/runtime-serialization": "workspace:*",
    "@prisma/client": "6.19.3",
    "@mentora/runtime-bootstrap": "workspace:*",
    "@mentora/runtime-relay": "workspace:*"
  }
}
