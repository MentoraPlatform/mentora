{
  "name": "@mentora/testing-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contract-test helpers: port/interface shape verification and reusable contract suites.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@mentora/kernel": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=2.1.0"
  },
  "devDependencies": {
    "@mentora/eslint-config": "workspace:*",
    "@mentora/testing-config": "workspace:*",
    "@mentora/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
