{
  "name": "@mentora/app-server",
  "version": "0.0.0",
  "private": true,
  "description": "The first Mentora executable - the Application species (F5.1) hosting the Agreement graph over PostgreSQL, the Outbox relay (dev-mixed, tolerated locally), and the runtime health surfaces. One Root, one boot, fail closed.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "start": "node dist/main.js",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@mentora/eslint-config": "workspace:*",
    "@mentora/eslint-plugin-mentora": "workspace:*",
    "@mentora/testing-clock": "workspace:*",
    "@mentora/testing-config": "workspace:*",
    "@mentora/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "rimraf": "6.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@mentora/adapters-persistence-account": "workspace:*",
    "@mentora/adapters-persistence-agreement": "workspace:*",
    "@mentora/adapters-persistence-identity": "workspace:*",
    "@mentora/application-account": "workspace:*",
    "@mentora/application-agreement": "workspace:*",
    "@mentora/application-identity": "workspace:*",
    "@mentora/application-kernel": "workspace:*",
    "@mentora/contracts": "workspace:*",
    "@mentora/contracts-account": "workspace:*",
    "@mentora/contracts-identity": "workspace:*",
    "@mentora/domain-account": "workspace:*",
    "@mentora/domain-agreement": "workspace:*",
    "@mentora/domain-identity": "workspace:*",
    "@mentora/kernel": "workspace:*",
    "@mentora/runtime-bootstrap": "workspace:*",
    "@mentora/runtime-clock": "workspace:*",
    "@mentora/runtime-config": "workspace:*",
    "@mentora/runtime-health": "workspace:*",
    "@mentora/runtime-identity": "workspace:*",
    "@mentora/runtime-logging": "workspace:*",
    "@mentora/runtime-metrics": "workspace:*",
    "@mentora/runtime-relay": "workspace:*",
    "@mentora/runtime-tracing": "workspace:*",
    "@mentora/shared": "workspace:*"
  }
