{
  "name": "@mentora/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Mentora engineering platform — TypeScript/NestJS monorepo implementing the frozen Foundation (foundation-v1.0.0). Contains no business logic at Lot 0A.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "^22.13.0 || >=24",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "verify": "turbo run typecheck lint test build",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.9.14",
    "typescript": "5.6.3",
    "@turbo/gen": "2.3.3"
  }
}
